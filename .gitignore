# ==========================================
# SubtitleBoom v1.0
# Git ignore rules
# ==========================================

# .NET build output
**/bin/
**/obj/
PROGRAM/
publish/

# Visual Studio / IDE
.vs/
.idea/
*.user
*.suo

# Temporary / validation folders
JSON_CHECK_TEMP/
JsonCheck/

# Backups and temporary files
BACKUP_*/
*.bak
*.tmp
*.old
*.backup
*.BACKUP_*

# Whisper models
runtime/models/*.bin
runtime/models/*.gguf

# Runtime binaries
runtime/bin/*.exe
runtime/bin/*.dll

# Local caches / user data
SubtitleBoom_Data/
*.cache

# Logs
*.log

# OS files
Thumbs.db
Desktop.ini
.DS_Store
